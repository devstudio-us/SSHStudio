{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHStudio",
  "version": "0.3.4",
  "identifier": "com.devstudio.sshmanger",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/sshstudio/browser"
  },
  "app": {
    "windows": [
      {
        "title": "SSHStudio",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/devstudio-us/SSHStudio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNDZEQjZFODIwNEY2NjYKUldSbTlnU0NidHRHMGlKUFBaQk1qN2Y2MVV1QjZVNFpsN1JhTy8xYkVvOGhCd0lPcy9CNERDSnEK"
    }
  }
}
